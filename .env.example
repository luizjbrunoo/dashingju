OPENAI_API_KEY=
DATAJUD_API_KEY=
EVOLUTION_API_BASE_URL=
EVOLUTION_INSTANCE_KEY=
EVOLUTION_LOGIN_EMAIL=
EVOLUTION_LOGIN_PASSWORD=
IA_WEBHOOK_SECRET=
IA_WHATSAPP_USER_ID=
# Storage de arquivos (DEV default = FileSystemStorage). Staging/prod: S3-compatible.
# Não servir /media/documentos publicamente. Não colocar credentials aqui.
# DJANGO_DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
# DJANGO_OBJECT_STORAGE_REQUIRED=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_S3_ADDRESSING_STYLE=

# Banco (DEV default = SQLite local). Não commitar .env. Não colocar credentials aqui.
# Staging/prod: injetar DATABASE_URL postgres/postgresql externamente (ex. Railway).
# DATABASE_URL=
# DB_CONN_MAX_AGE=0

# Django runtime (DEV: DEBUG ausente = true. STAGING: DJANGO_DEBUG=false)
# DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Cofre por Organization (Fernet). Runtime Web/Worker apenas — não é necessária no build/collectstatic/migrate.
# Staging/prod: obrigatória para put/get. Não usar chave derivada de DEV.
# INTEGRATION_CREDENTIALS_KEY=

# OAuth Google Ads (runtime Web). Não usar no Dockerfile/build.
# Staging/prod: HTTPS absoluto, sem wildcard. Mesmo Client ID no Web e Worker.
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_OAUTH_REDIRECT_URI=

# Feature flag da Conta Financeira / subconta Asaas.
# Ausente, vazio ou inválido = desligado (fail-closed). true/1/yes/on liga.
# ASAAS_BAAS_ENABLED=false
# Asaas BaaS. URL vem só de SANDBOX|PRODUCTION — não injetar host.
# Chave-pai: somente processo Web (deploy/web.sh define DJANGO_PROCESS=web).
# NÃO definir ASAAS_PARENT_API_KEY no Worker.
# DJANGO_PROCESS=web
# ASAAS_ENVIRONMENT=SANDBOX
# ASAAS_PARENT_API_KEY=
# Base HTTPS da aplicação. O webhook Asaas é montado como
# <PUBLIC_BASE_URL>/financeiro/webhooks/asaas/<uuid>/
# Não colocar segredo na URL. Não usar URL arbitrária do usuário.
# PUBLIC_BASE_URL=https://app.example.com
# E-mail operacional do webhook (plataforma). Não usar o e-mail do cliente.
# Somente Web. Não definir no Worker.
# ASAAS_WEBHOOK_EMAIL=ops@example.com

# WhatsApp Cloud API (Meta). Webhook oficial em /integrations/whatsapp/webhook/
# GET usa WHATSAPP_WEBHOOK_VERIFY_TOKEN. POST valida X-Hub-Signature-256 com o App Secret.
# Ausente/vazio = fail-closed (403). Não commitar valores reais.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# META_WHATSAPP_APP_SECRET=

# Web / Gunicorn (PORT vem do Railway)
# PORT=8000
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=60
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=5

# Worker Django-Q (broker = ORM default; Redis não é requerido)
# Q_CLUSTER_NAME=pythonando
# Q_CLUSTER_WORKERS=1
# Q_CLUSTER_TIMEOUT=180
# Q_CLUSTER_RETRY=200
# Q_CLUSTER_QUEUE_LIMIT=50
